{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Temporal", "ESNext.Intl"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma", "prisma.config.ts", "vitest.config.ts"]
}
